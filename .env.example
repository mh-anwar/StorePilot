# Filled in automatically by `shopify app dev`. Set these yourself in production.
SHOPIFY_API_KEY=            # Client ID from the Partner dashboard
SHOPIFY_API_SECRET=         # Client secret from the Partner dashboard
SHOPIFY_APP_URL=            # Public https URL, no trailing slash (auto-detected on Render and Fly)
SCOPES=read_orders,read_customers,read_legal_policies,read_shopify_payments_disputes,read_shopify_payments_dispute_evidences,write_shopify_payments_dispute_evidences

# SQLite file. On Fly/Render this lives on a mounted volume.
DATABASE_URL=file:./dev.sqlite

# Optional: enables Claude-written drafts. Without it StorePilot uses template drafts.
ANTHROPIC_API_KEY=
# STOREPILOT_MODEL=claude-opus-5-5

# Billing: charges are created in test mode unless this is "false".
BILLING_TEST_MODE=true

# Contact shown on the privacy policy page.
PRIVACY_CONTACT_EMAIL=privacy@example.com

# Webhooks are also registered over the API on install, so a Dev Dashboard app
# works without `shopify app deploy`. Set to "off" if you deploy shopify.app.toml.
# REGISTER_WEBHOOKS=on

# The public /demo runs on seeded data. "off" disables it; DEMO_AI=on lets it
# spend your Anthropic credits on Claude drafts (off by default).
# DEMO_MODE=on
# DEMO_AI=off

# Deadline alert emails for Growth/Pro (via Resend). Without these, alerts are skipped.
# RESEND_API_KEY=
# ALERTS_FROM_EMAIL=StorePilot <alerts@yourdomain.com>
# DEADLINE_ALERTS=on
# CRON_SECRET=            # enables /cron/deadlines for an external scheduler
